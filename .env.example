# Any PostgreSQL reachable by this URL works: local install, Docker, or a hosted tier (Neon, Supabase).
# The values below match the optional docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms?schema=public"

# Shows the Viewing as role switcher. Demo only, never enable in production.
DEMO_ROLE_SWITCHER="true"

# Where uploaded submissions are stored (relative to the project root). Never served directly.
UPLOAD_DIR="uploads"
